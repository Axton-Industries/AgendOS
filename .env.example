# AI (user-provided key, server-side only — never shipped to the client)
# Works with OpenAI or any compatible endpoint (OpenRouter, Ollama, LM Studio...)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Weather provider: openmeteo (default, no key needed) | aemet (not implemented yet)
WEATHER_PROVIDER=openmeteo
